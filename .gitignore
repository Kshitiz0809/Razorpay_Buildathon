# Data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts (regenerable; keep only metadata)
models/champion/*
!models/champion/.gitkeep

# Reports (regenerable)
reports/figures/*
!reports/figures/.gitkeep
reports/*.json
reports/*.parquet

# Mock-service runtime logs (accumulate demo data; seed data like
# chargeback_history.json is NOT excluded, only generated logs)
data/mock_services/submitted_disputes.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Env / secrets
.env
kaggle.json

# OS / editor
.DS_Store
.vscode/
.idea/
