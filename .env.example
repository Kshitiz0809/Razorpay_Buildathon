# Copy this file to .env and set a real secret before running the API.
API_KEY=change-me-to-a-real-secret

# Used by the dashboard to reach the API.
API_BASE_URL=http://localhost:8000

# Optional: only needed for the live Razorpay integration (dashboard's
# "Razorpay Live" page, scripts/seed_razorpay_test_orders.py,
# scripts/simulate_razorpay_webhook.py). Use TEST MODE credentials only --
# key_id must start with rzp_test_, the client refuses to write against
# anything else. Get these from the Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=rzp_test_change-me
RAZORPAY_KEY_SECRET=change-me
# Any string -- mirrors the webhook secret you'd configure in the Razorpay
# Dashboard under Settings > Webhooks for a real deployment.
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret
